	real ids_value = 0;

    // 1D interpolation for ids
    analog function real interpolate_1d_ids;
		input x;
		input y;
		input z;
		input [0 : vds_width_int-1] x_points;
		input [0 : vgs_width_int-1] y_points;
		input [0 : vgd_width_int-1] z_points;
		input [0 : vds_width_int*vgs_width_int*vgd_width_int-1] ids_table;
		real x;
		real y;
		real z;
		real x_points[0 : vds_width_int-1];
		real y_points[0 : vgs_width_int-1];
		real z_points[0 : vgd_width_int-1];
		real ids_table[0 : vds_width_int*vgs_width_int*vgd_width_int-1];
        integer i;
        integer j;
        integer k;
        integer ii = 0;
        integer jj = 0;
        integer kk = 0;
        real x1, x2, ids1, ids2, dx;
        begin
			///// vds conditions /////
			if(x < x_points[0]) 
				ii = 0;
			else if(x >= x_points[vds_width_int - 1]) 
				ii = vds_width_int - 2;
			else
				for (i = 0; i < vds_width_int - 1; i = i + 1) begin
					if (x_points[i] <= x && x <= x_points[i+1]) 
						ii = i;
				end
			
			///// vgs conditions /////			
			for (j = 0; j < vgs_width_int - 1; j = j + 1) begin	
				if(y < y_points[0]) 
					jj = 0;
				else if(y_points[j] <= y && y < y_points[j+1]/2) 
					jj = j;
				else if(y_points[j+1]/2 <= y && y < y_points[j+1])
					jj = j+1;
				else 
					jj = jj;
			end 
				if(y >= y_points[vgs_width_int - 1])
					jj = vgs_width_int - 1;
					
			///// vgd conditions /////		
			for (k = 0; k < vgd_width_int - 1; k = k + 1) begin	
				if(z < z_points[0]) 
					kk = 0;
				else if(z_points[k] <= z && z < z_points[k+1]/2) 
					kk = k;
				else if(z_points[k+1]/2 <= z && z < z_points[k+1])
					kk = k+1;
				else
					kk = kk;
			end 
			if(z >= z_points[vgd_width_int - 1])
					kk = vgd_width_int - 1;
			
			///// 1D interpolation for Vds /////	
            x1 = x_points[ii]; x2 = x_points[ii+1];
            ids1 = ids_table[(jj*vds_width_int*vgd_width_int)+(kk*vds_width_int)+ii]; ids2 = ids_table[(jj*vds_width_int*vgd_width_int)+(kk*vds_width_int)+ii+1];
            dx = (x - x1) / (x2 - x1);
            interpolate_1d_ids = ids1 * (1 - dx) + ids2 * dx;
        end
    endfunction

	analog function real interpolate_3d_ids;
		input x;  // Vds
		input y;  // Vgs
		input z;  // Vgd
		input [0 : vds_width_int-1] x_points; // Vds grid
		input [0 : vgs_width_int-1] y_points; // Vgs grid
		input [0 : vgd_width_int-1] z_points; // Vgd grid
		input [0 : vds_width_int * vgs_width_int * vgd_width_int - 1] ids_table;
	
		real x, y, z;
		real x_points[0 : vds_width_int-1];
		real y_points[0 : vgs_width_int-1];
		real z_points[0 : vgd_width_int-1];
		real ids_table[0 : vds_width_int * vgs_width_int * vgd_width_int - 1];
	
		integer i, j, k;
		integer ii = 0, jj = 0, kk = 0;
		real x1, x2, y1, y2, z1, z2;
		real c000, c001, c010, c011, c100, c101, c110, c111;
		real dx, dy, dz;
	
		begin
			// Locate the indices for x (Vds)
			if (x < x_points[0])
				ii = 0;
			else if (x >= x_points[vds_width_int - 1])
				ii = vds_width_int - 2;
			else
				for (i = 0; i < vds_width_int - 1; i = i + 1) begin
					if (x_points[i] <= x && x <= x_points[i+1])
						ii = i;
				end
	
			// Locate the indices for y (Vgs)
			if (y < y_points[0])
				jj = 0;
			else if (y >= y_points[vgs_width_int - 1])
				jj = vgs_width_int - 2;
			else
				for (j = 0; j < vgs_width_int - 1; j = j + 1) begin
					if (y_points[j] <= y && y <= y_points[j+1])
						jj = j;
				end
	
			// Locate the indices for z (Vgd)
			if (z < z_points[0])
				kk = 0;
			else if (z >= z_points[vgd_width_int - 1])
				kk = vgd_width_int - 2;
			else
				for (k = 0; k < vgd_width_int - 1; k = k + 1) begin
					if (z_points[k] <= z && z <= z_points[k+1])
						kk = k;
				end
	
			// Define surrounding grid points
			x1 = x_points[ii]; x2 = x_points[ii+1];
			y1 = y_points[jj]; y2 = y_points[jj+1];
			z1 = z_points[kk]; z2 = z_points[kk+1];
	
			// Extract values from ids_table
			c000 = ids_table[(jj * vds_width_int * vgd_width_int) + (kk * vds_width_int) + ii];
			c001 = ids_table[(jj * vds_width_int * vgd_width_int) + ((kk+1) * vds_width_int) + ii];
			c010 = ids_table[((jj+1) * vds_width_int * vgd_width_int) + (kk * vds_width_int) + ii];
			c011 = ids_table[((jj+1) * vds_width_int * vgd_width_int) + ((kk+1) * vds_width_int) + ii];
			c100 = ids_table[(jj * vds_width_int * vgd_width_int) + (kk * vds_width_int) + (ii+1)];
			c101 = ids_table[(jj * vds_width_int * vgd_width_int) + ((kk+1) * vds_width_int) + (ii+1)];
			c110 = ids_table[((jj+1) * vds_width_int * vgd_width_int) + (kk * vds_width_int) + (ii+1)];
			c111 = ids_table[((jj+1) * vds_width_int * vgd_width_int) + ((kk+1) * vds_width_int) + (ii+1)];
	
			// Calculate weights
			dx = (x - x1) / (x2 - x1);
			dy = (y - y1) / (y2 - y1);
			dz = (z - z1) / (z2 - z1);
	
			// Perform trilinear interpolation
			interpolate_3d_ids = 
				c000 * (1 - dx) * (1 - dy) * (1 - dz) +
				c001 * (1 - dx) * (1 - dy) * dz +
				c010 * (1 - dx) * dy * (1 - dz) +
				c011 * (1 - dx) * dy * dz +
				c100 * dx * (1 - dy) * (1 - dz) +
				c101 * dx * (1 - dy) * dz +
				c110 * dx * dy * (1 - dz) +
				c111 * dx * dy * dz;
		end
	endfunction

    analog begin
        // Compute Ids using 1D interpolation
         ids_value = interpolate_1d_ids(V(d, s), V(gs, b), V(gd, b), vds_points, vgs_points, vgd_points, table_ids);
        // ids_value = interpolate_3d_ids(V(d, s), V(gs, s), V(gd, s), vds_points, vgs_points, vgd_points, table_ids);

        // Define currents and charges
        I(d, s) <+ ids_value;
    end
endmodule
