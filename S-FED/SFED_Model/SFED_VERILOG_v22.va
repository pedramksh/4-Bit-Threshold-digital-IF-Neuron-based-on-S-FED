		,2.535656237e-016
		,2.501162789e-016
		,2.457027367e-016
		,2.374181131e-016
		,2.357201632e-016
		,2.368731415e-016
		,2.392217411e-016
		,2.411508766e-016
		,2.504408496e-016
		,2.562471161e-016
		,2.588800257e-016
		,2.607108700e-016
		,2.612843789e-016
		,2.635118589e-016
		,2.634996162e-016
	};
// --------------------------------------------------    Cgd_FINISH	    --------------------------------------------------	

	real ids_value = 0;
	real Cgs_value = 0;
	real Cgd_value = 0;

	analog function real interpolate_smoothed_ids;
		input x, y, z;
		input [0:vds_width_int-1] x_points;
		input [0:vgs_width_int-1] y_points;
		input [0:vgd_width_int-1] z_points;
		input [0:vds_width_int*vgs_width_int*vgd_width_int-1] ids_table;

		real x, y, z;
		real x_points[0:vds_width_int-1];
		real y_points[0:vgs_width_int-1];
		real z_points[0:vgd_width_int-1];
		real ids_table[0:vds_width_int*vgs_width_int*vgd_width_int-1];

		integer i, j, k;
		integer ii, jj, kk;
		real x1, x2, dx;
		real y1, y2, alpha_y;
		real z1, z2, alpha_z;
		real id00, id01, id10, id11;
		real id_low, id_high;
		real ids;

		begin
			// --- Vds axis (linear interpolation between ii and ii+1) ---
			if (x <= x_points[0])
				ii = 0;
			else if (x >= x_points[vds_width_int - 1])
				ii = vds_width_int - 2;
			else
				for (i = 0; i < vds_width_int - 1; i = i + 1)
					if (x_points[i] <= x && x < x_points[i+1])
						ii = i;
			x1 = x_points[ii]; x2 = x_points[ii+1];
			dx = (x - x1) / (x2 - x1);

			// --- Vgs axis (smooth fractional blending) ---
			for (j = 0; j < vgs_width_int - 1; j = j + 1)
				if (y_points[j] <= y && y <= y_points[j+1]) begin
					jj = j;
					y1 = y_points[j]; y2 = y_points[j+1];
					alpha_y = (y - y1) / (y2 - y1);
				end

			if (y <= y_points[0]) begin
				jj = 0; alpha_y = 0;
			end else if (y >= y_points[vgs_width_int - 1]) begin
				jj = vgs_width_int - 2; alpha_y = 1;
			end

			// --- Vgd axis (smooth fractional blending) ---
			for (k = 0; k < vgd_width_int - 1; k = k + 1)
				if (z_points[k] <= z && z <= z_points[k+1]) begin
					kk = k;
					z1 = z_points[k]; z2 = z_points[k+1];
					alpha_z = (z - z1) / (z2 - z1);
				end

			if (z <= z_points[0]) begin
				kk = 0; alpha_z = 0;
			end else if (z >= z_points[vgd_width_int - 1]) begin
				kk = vgd_width_int - 2; alpha_z = 1;
			end

			// --- Fetch values for Vds = x_points[ii] ---
			id00 = ids_table[(jj*vds_width_int*vgd_width_int)+(kk*vds_width_int)+ii];
			id01 = ids_table[(jj*vds_width_int*vgd_width_int)+((kk+1)*vds_width_int)+ii];
			id10 = ids_table[((jj+1)*vds_width_int*vgd_width_int)+(kk*vds_width_int)+ii];
			id11 = ids_table[((jj+1)*vds_width_int*vgd_width_int)+((kk+1)*vds_width_int)+ii];

			id_low = id00 * (1 - alpha_y) * (1 - alpha_z) +
					 id01 * (1 - alpha_y) * alpha_z +
					 id10 * alpha_y * (1 - alpha_z) +
					 id11 * alpha_y * alpha_z;

			// --- Fetch values for Vds = x_points[ii+1] ---
			id00 = ids_table[(jj*vds_width_int*vgd_width_int)+(kk*vds_width_int)+(ii+1)];
			id01 = ids_table[(jj*vds_width_int*vgd_width_int)+((kk+1)*vds_width_int)+(ii+1)];
			id10 = ids_table[((jj+1)*vds_width_int*vgd_width_int)+(kk*vds_width_int)+(ii+1)];
			id11 = ids_table[((jj+1)*vds_width_int*vgd_width_int)+((kk+1)*vds_width_int)+(ii+1)];

			id_high = id00 * (1 - alpha_y) * (1 - alpha_z) +
					  id01 * (1 - alpha_y) * alpha_z +
					  id10 * alpha_y * (1 - alpha_z) +
					  id11 * alpha_y * alpha_z;

			// Final interpolation across Vds
			ids = id_low * (1 - dx) + id_high * dx;

			interpolate_smoothed_ids = ids;
		end
	endfunction
	
	analog function real interpolate_smoothed_Cgs;
		input x, y, z;
		input [0:vgs_width_int_Cgs-1] x_points;
		input [0:vds_width_int_Cgs-1] y_points;
		input [0:vgd_width_int_Cgs-1] z_points;
		input [0:vgs_width_int_Cgs*vds_width_int_Cgs*vgd_width_int_Cgs-1] Cgs_table;

		real x, y, z;
		real x_points[0:vgs_width_int_Cgs-1];
		real y_points[0:vds_width_int_Cgs-1];
		real z_points[0:vgd_width_int_Cgs-1];
		real Cgs_table[0:vgs_width_int_Cgs*vds_width_int_Cgs*vgd_width_int_Cgs-1];

		integer i, j, k;
		integer ii, jj, kk;
		real x1, x2, dx;
		real y1, y2, alpha_y;
		real z1, z2, alpha_z;
		real c00, c01, c10, c11;
		real c_low, c_high;
		real Cgs;

		begin
			// --- Vgs axis (x) ---
			if (x <= x_points[0])
				ii = 0;
			else if (x >= x_points[vgs_width_int_Cgs - 1])
				ii = vgs_width_int_Cgs - 2;
			else
				for (i = 0; i < vgs_width_int_Cgs - 1; i = i + 1)
					if (x_points[i] <= x && x < x_points[i+1])
						ii = i;
			x1 = x_points[ii]; x2 = x_points[ii+1];
			dx = (x - x1) / (x2 - x1);

			// --- Vds axis (y) ---
			for (j = 0; j < vds_width_int_Cgs - 1; j = j + 1)
				if (y_points[j] <= y && y <= y_points[j+1]) begin
					jj = j;
					y1 = y_points[j]; y2 = y_points[j+1];
					alpha_y = (y - y1) / (y2 - y1);
				end
			if (y <= y_points[0]) begin
				jj = 0; alpha_y = 0;
			end else if (y >= y_points[vds_width_int_Cgs - 1]) begin
				jj = vds_width_int_Cgs - 2; alpha_y = 1;
			end

			// --- Vgd axis (z) ---
			for (k = 0; k < vgd_width_int_Cgs - 1; k = k + 1)
				if (z_points[k] <= z && z <= z_points[k+1]) begin
					kk = k;
					z1 = z_points[k]; z2 = z_points[k+1];
					alpha_z = (z - z1) / (z2 - z1);
				end
			if (z <= z_points[0]) begin
				kk = 0; alpha_z = 0;
			end else if (z >= z_points[vgd_width_int_Cgs - 1]) begin
				kk = vgd_width_int_Cgs - 2; alpha_z = 1;
			end

			// --- Fetch values for x_points[ii] ---
			c00 = Cgs_table[(kk * vgs_width_int_Cgs * vds_width_int_Cgs) + (jj * vgs_width_int_Cgs) + ii];
			c01 = Cgs_table[((kk+1) * vgs_width_int_Cgs * vds_width_int_Cgs) + (jj * vgs_width_int_Cgs) + ii];
			c10 = Cgs_table[(kk * vgs_width_int_Cgs * vds_width_int_Cgs) + ((jj+1) * vgs_width_int_Cgs) + ii];
			c11 = Cgs_table[((kk+1) * vgs_width_int_Cgs * vds_width_int_Cgs) + ((jj+1) * vgs_width_int_Cgs) + ii];

			c_low = c00 * (1 - alpha_y) * (1 - alpha_z) +
					c01 * (1 - alpha_y) * alpha_z +
					c10 * alpha_y * (1 - alpha_z) +
					c11 * alpha_y * alpha_z;

			// --- Fetch values for x_points[ii+1] ---
			c00 = Cgs_table[(kk * vgs_width_int_Cgs * vds_width_int_Cgs) + (jj * vgs_width_int_Cgs) + (ii+1)];
			c01 = Cgs_table[((kk+1) * vgs_width_int_Cgs * vds_width_int_Cgs) + (jj * vgs_width_int_Cgs) + (ii+1)];
			c10 = Cgs_table[(kk * vgs_width_int_Cgs * vds_width_int_Cgs) + ((jj+1) * vgs_width_int_Cgs) + (ii+1)];
			c11 = Cgs_table[((kk+1) * vgs_width_int_Cgs * vds_width_int_Cgs) + ((jj+1) * vgs_width_int_Cgs) + (ii+1)];

			c_high = c00 * (1 - alpha_y) * (1 - alpha_z) +
					 c01 * (1 - alpha_y) * alpha_z +
					 c10 * alpha_y * (1 - alpha_z) +
					 c11 * alpha_y * alpha_z;

			// Final interpolation across Vgs
			Cgs = c_low * (1 - dx) + c_high * dx;

			interpolate_smoothed_Cgs = Cgs;
		end
	endfunction

	
	analog function real interpolate_smoothed_Cgd;
		input x, y, z;
		input [0:vgd_width_int_Cgd-1] x_points;
		input [0:vds_width_int_Cgd-1] y_points;
		input [0:vgs_width_int_Cgd-1] z_points;
		input [0:vgd_width_int_Cgd*vds_width_int_Cgd*vgs_width_int_Cgd-1] Cgd_table;

		real x, y, z;
		real x_points[0:vgd_width_int_Cgd-1];
		real y_points[0:vds_width_int_Cgd-1];
		real z_points[0:vgs_width_int_Cgd-1];
		real Cgd_table[0:vgd_width_int_Cgd*vds_width_int_Cgd*vgs_width_int_Cgd-1];

		integer i, j, k;
		integer ii, jj, kk;
		real x1, x2, dx;
		real y1, y2, alpha_y;
		real z1, z2, alpha_z;
		real c00, c01, c10, c11;
		real c_low, c_high;
		real Cgd;

		begin
			// --- Vgd axis (x) ---
			if (x <= x_points[0])
				ii = 0;
			else if (x >= x_points[vgd_width_int_Cgd - 1])
				ii = vgd_width_int_Cgd - 2;
			else
				for (i = 0; i < vgd_width_int_Cgd - 1; i = i + 1)
					if (x_points[i] <= x && x < x_points[i+1])
						ii = i;
			x1 = x_points[ii]; x2 = x_points[ii+1];
			dx = (x - x1) / (x2 - x1);

			// --- Vds axis (y) ---
			for (j = 0; j < vds_width_int_Cgd - 1; j = j + 1)
				if (y_points[j] <= y && y <= y_points[j+1]) begin
					jj = j;
					y1 = y_points[j]; y2 = y_points[j+1];
					alpha_y = (y - y1) / (y2 - y1);
				end
			if (y <= y_points[0]) begin
				jj = 0; alpha_y = 0;
			end else if (y >= y_points[vds_width_int_Cgd - 1]) begin
				jj = vds_width_int_Cgd - 2; alpha_y = 1;
			end

			// --- Vgs axis (z) ---
			for (k = 0; k < vgs_width_int_Cgd - 1; k = k + 1)
				if (z_points[k] <= z && z <= z_points[k+1]) begin
					kk = k;
					z1 = z_points[k]; z2 = z_points[k+1];
					alpha_z = (z - z1) / (z2 - z1);
				end
			if (z <= z_points[0]) begin
				kk = 0; alpha_z = 0;
			end else if (z >= z_points[vgs_width_int_Cgd - 1]) begin
				kk = vgs_width_int_Cgd - 2; alpha_z = 1;
			end

			// --- Fetch values for x_points[ii] ---
			c00 = Cgd_table[(kk * vgd_width_int_Cgd * vds_width_int_Cgd) + (jj * vgd_width_int_Cgd) + ii];
			c01 = Cgd_table[((kk+1) * vgd_width_int_Cgd * vds_width_int_Cgd) + (jj * vgd_width_int_Cgd) + ii];
			c10 = Cgd_table[(kk * vgd_width_int_Cgd * vds_width_int_Cgd) + ((jj+1) * vgd_width_int_Cgd) + ii];
			c11 = Cgd_table[((kk+1) * vgd_width_int_Cgd * vds_width_int_Cgd) + ((jj+1) * vgd_width_int_Cgd) + ii];

			c_low = c00 * (1 - alpha_y) * (1 - alpha_z) +
					c01 * (1 - alpha_y) * alpha_z +
					c10 * alpha_y * (1 - alpha_z) +
					c11 * alpha_y * alpha_z;

			// --- Fetch values for x_points[ii+1] ---
			c00 = Cgd_table[(kk * vgd_width_int_Cgd * vds_width_int_Cgd) + (jj * vgd_width_int_Cgd) + (ii+1)];
			c01 = Cgd_table[((kk+1) * vgd_width_int_Cgd * vds_width_int_Cgd) + (jj * vgd_width_int_Cgd) + (ii+1)];
			c10 = Cgd_table[(kk * vgd_width_int_Cgd * vds_width_int_Cgd) + ((jj+1) * vgd_width_int_Cgd) + (ii+1)];
			c11 = Cgd_table[((kk+1) * vgd_width_int_Cgd * vds_width_int_Cgd) + ((jj+1) * vgd_width_int_Cgd) + (ii+1)];

			c_high = c00 * (1 - alpha_y) * (1 - alpha_z) +
					 c01 * (1 - alpha_y) * alpha_z +
					 c10 * alpha_y * (1 - alpha_z) +
					 c11 * alpha_y * alpha_z;

			// Final interpolation in Vgd
			Cgd = c_low * (1 - dx) + c_high * dx;

			interpolate_smoothed_Cgd = Cgd;
		end
	endfunction
	
	
	// Put near your params
	parameter real EPS_DEN = 1e-12; // protects against zero/very-small denominators

	analog function real clip01;
		input a;
		real a;
		begin
			if (a <= 0.0) clip01 = 0.0;
			else if (a >= 1.0) clip01 = 1.0;
			else clip01 = a;
		end
	endfunction
	
	// ---------- numerical guard parameters ----------
	parameter real Cmin      = 1e-18;   // floor for caps (aF)
	parameter real gmin      = 1e-9;    // tiny DC rails to bulk (1 GΩ)
	parameter real gds_floor = 1e-12;    // tiny linear conductance in Ids path (helps Newton)
	parameter real VCLIP_K   = 5e-3;    // softness (V) for soft clamp
	parameter real MAXSTEP   = 5e-11;   // time-step bound suggestion (50 ps)

	// ---------- smooth softplus-based clamp to [lo, hi] ----------
	// analog function real soft_clip;
		// input x, lo, hi, k;
		// real x, lo, hi, k;
		// real t1, t2;
		// begin
			// // softplus: k*ln(1+exp((x-lo)/k)) grows smoothly; subtract softplus to clip at hi
			// t1 = k*ln(1.0 + exp((x - lo)/k));
			// t2 = k*ln(1.0 + exp((x - hi)/k));
			// soft_clip = lo + t1 - t2; // C^∞ smooth clamp to [lo, hi]
		// end
	// endfunction
	
	// Safe softplus: ln(1+exp(a)) without overflow
	analog function real softplus;
	  input a;
	  real a;
	  real r;
	  begin
		if (a > 0.0)
		  // for large +a, use exp(-a) which is tiny -> no overflow
		  r = a + ln(1.0 + exp(-a));
		else
		  // for a <= 0, exp(a) <= 1 -> safe
		  r = ln(1.0 + exp(a));
		softplus = r;
	  end
	endfunction
	
	// Smooth clamp x to [lo, hi] using softplus; k sets softness (V)
	analog function real soft_clip;
	  input x, lo, hi, k;
	  real x, lo, hi, k;
	  real u, v;
	  begin
		// lo + k*softplus((x-lo)/k) - k*softplus((x-hi)/k)
		u = k * softplus((x - lo)/k);
		v = k * softplus((x - hi)/k);
		soft_clip = lo + u - v;
	  end
	endfunction


	// ---------- smooth max(x, xmin) (C^1) ----------
	analog function real smooth_max;
		input x, xmin, k;
		real x, xmin, k, dx;
		begin
			dx = x - xmin;
			smooth_max = 0.5*(dx + sqrt(dx*dx + k)) + xmin;
		end
	endfunction



	analog function real interpolate_smoothed2_ids;
		input x, y, z;
		input [0:vds_width_int-1] x_points;
		input [0:vgs_width_int-1] y_points;
		input [0:vgd_width_int-1] z_points;
		input [0:vds_width_int*vgs_width_int*vgd_width_int-1] ids_table;

		real x, y, z;
		real x_points[0:vds_width_int-1];
		real y_points[0:vgs_width_int-1];
		real z_points[0:vgd_width_int-1];
		real ids_table[0:vds_width_int*vgs_width_int*vgd_width_int-1];

		integer i, j, k;
		integer ii, jj, kk;
		real x1, x2, dx, denx;
		real y1, y2, alpha_y, deny;
		real z1, z2, alpha_z, denz;
		real id00, id01, id10, id11;
		real id_low, id_high, ids;

		begin
			// --- Vds axis (locate ii) ---
			if (x <= x_points[0])
				ii = 0;
			else if (x >= x_points[vds_width_int-1])
				ii = vds_width_int-2;
			else
				for (i = 0; i < vds_width_int-1; i = i + 1)
					if (x_points[i] <= x && x < x_points[i+1])
						ii = i;

			x1 = x_points[ii]; x2 = x_points[ii+1];
			denx = x2 - x1; if (denx < EPS_DEN) denx = EPS_DEN;
			dx = (x - x1) / denx;  // do NOT clip dx; allows mild extrapolation near edges

			// --- Vgs axis (locate jj, compute alpha_y) ---
			for (j = 0; j < vgs_width_int-1; j = j + 1)
				if (y_points[j] <= y && y <= y_points[j+1]) begin
					jj = j;
					y1 = y_points[j]; y2 = y_points[j+1];
				end
			if (y <= y_points[0]) begin
				jj = 0; y1 = y_points[0]; y2 = y_points[1];
			end else if (y >= y_points[vgs_width_int-1]) begin
				jj = vgs_width_int-2; y1 = y_points[vgs_width_int-2]; y2 = y_points[vgs_width_int-1];
			end
			deny = y2 - y1; if (deny < EPS_DEN) deny = EPS_DEN;
			// alpha_y = clip01( (y - y1) / deny );
			alpha_y = (y - y1) / deny;   // no hard clip (we soft-clipped inputs already)

			// --- Vgd axis (locate kk, compute alpha_z) ---
			for (k = 0; k < vgd_width_int-1; k = k + 1)
				if (z_points[k] <= z && z <= z_points[k+1]) begin
					kk = k;
					z1 = z_points[k]; z2 = z_points[k+1];
				end
			if (z <= z_points[0]) begin
				kk = 0; z1 = z_points[0]; z2 = z_points[1];
			end else if (z >= z_points[vgd_width_int-1]) begin
				kk = vgd_width_int-2; z1 = z_points[vgd_width_int-2]; z2 = z_points[vgd_width_int-1];
			end
			denz = z2 - z1; if (denz < EPS_DEN) denz = EPS_DEN;
			// alpha_z = clip01( (z - z1) / denz );
			alpha_z = (z - z1) / denz; // no hard clip (we soft-clipped inputs already)
			
			// --- Fetch values for Vds = x_points[ii] ---
			id00 = ids_table[(jj*vds_width_int*vgd_width_int) + (kk*vds_width_int) + ii];
			id01 = ids_table[(jj*vds_width_int*vgd_width_int) + ((kk+1)*vds_width_int) + ii];
			id10 = ids_table[((jj+1)*vds_width_int*vgd_width_int) + (kk*vds_width_int) + ii];
			id11 = ids_table[((jj+1)*vds_width_int*vgd_width_int) + ((kk+1)*vds_width_int) + ii];

			id_low = id00*(1 - alpha_y)*(1 - alpha_z)
				   + id01*(1 - alpha_y)*alpha_z
				   + id10*alpha_y*(1 - alpha_z)
				   + id11*alpha_y*alpha_z;

			// --- Fetch values for Vds = x_points[ii+1] ---
			id00 = ids_table[(jj*vds_width_int*vgd_width_int) + (kk*vds_width_int) + (ii+1)];
			id01 = ids_table[(jj*vds_width_int*vgd_width_int) + ((kk+1)*vds_width_int) + (ii+1)];
			id10 = ids_table[((jj+1)*vds_width_int*vgd_width_int) + (kk*vds_width_int) + (ii+1)];
			id11 = ids_table[((jj+1)*vds_width_int*vgd_width_int) + ((kk+1)*vds_width_int) + (ii+1)];

			id_high = id00*(1 - alpha_y)*(1 - alpha_z)
					+ id01*(1 - alpha_y)*alpha_z
					+ id10*alpha_y*(1 - alpha_z)
					+ id11*alpha_y*alpha_z;

			// --- Final across Vds ---
			ids = id_low*(1 - dx) + id_high*dx;

			interpolate_smoothed2_ids = ids;
		end
	endfunction


	analog function real interpolate_smoothed2_Cgs;
		input x, y, z;
		input [0:vgs_width_int_Cgs-1] x_points;
		input [0:vds_width_int_Cgs-1] y_points;
		input [0:vgd_width_int_Cgs-1] z_points;
		input [0:vgs_width_int_Cgs*vds_width_int_Cgs*vgd_width_int_Cgs-1] Cgs_table;

		real x, y, z;
		real x_points[0:vgs_width_int_Cgs-1];
		real y_points[0:vds_width_int_Cgs-1];
		real z_points[0:vgd_width_int_Cgs-1];
		real Cgs_table[0:vgs_width_int_Cgs*vds_width_int_Cgs*vgd_width_int_Cgs-1];

		integer i, j, k;
		integer ii, jj, kk;
		real x1, x2, dx, denx;
		real y1, y2, alpha_y, deny;
		real z1, z2, alpha_z, denz;
		real c00, c01, c10, c11, c_low, c_high, Cgs;

		begin
			// x (Vgs)
			if (x <= x_points[0]) ii = 0;
			else if (x >= x_points[vgs_width_int_Cgs-1]) ii = vgs_width_int_Cgs-2;
			else for (i = 0; i < vgs_width_int_Cgs-1; i = i + 1)
				if (x_points[i] <= x && x < x_points[i+1]) ii = i;
			x1 = x_points[ii]; x2 = x_points[ii+1];
			denx = x2 - x1; if (denx < EPS_DEN) denx = EPS_DEN;
			dx = (x - x1) / denx;

			// y (Vds)
			for (j = 0; j < vds_width_int_Cgs-1; j = j + 1)
				if (y_points[j] <= y && y <= y_points[j+1]) begin
					jj = j; y1 = y_points[j]; y2 = y_points[j+1];
				end
			if (y <= y_points[0]) begin jj = 0; y1 = y_points[0]; y2 = y_points[1]; end
			else if (y >= y_points[vds_width_int_Cgs-1]) begin jj = vds_width_int_Cgs-2; y1 = y_points[vds_width_int_Cgs-2]; y2 = y_points[vds_width_int_Cgs-1]; end
			deny = y2 - y1; if (deny < EPS_DEN) deny = EPS_DEN;
			// alpha_y = clip01( (y - y1) / deny );
			alpha_y = (y - y1) / deny;   // no hard clip (we soft-clipped inputs already)

			// z (Vgd)
			for (k = 0; k < vgd_width_int_Cgs-1; k = k + 1)
				if (z_points[k] <= z && z <= z_points[k+1]) begin
					kk = k; z1 = z_points[k]; z2 = z_points[k+1];
				end
			if (z <= z_points[0]) begin kk = 0; z1 = z_points[0]; z2 = z_points[1]; end
			else if (z >= z_points[vgd_width_int_Cgs-1]) begin kk = vgd_width_int_Cgs-2; z1 = z_points[vgd_width_int_Cgs-2]; z2 = z_points[vgd_width_int_Cgs-1]; end
			denz = z2 - z1; if (denz < EPS_DEN) denz = EPS_DEN;
			// alpha_z = clip01( (z - z1) / denz );
			alpha_z = (z - z1) / denz; // no hard clip (we soft-clipped inputs already)

			// fetch at ii
			c00 = Cgs_table[(kk*vgs_width_int_Cgs*vds_width_int_Cgs) + (jj*vgs_width_int_Cgs) + ii];
			c01 = Cgs_table[((kk+1)*vgs_width_int_Cgs*vds_width_int_Cgs) + (jj*vgs_width_int_Cgs) + ii];
			c10 = Cgs_table[(kk*vgs_width_int_Cgs*vds_width_int_Cgs) + ((jj+1)*vgs_width_int_Cgs) + ii];
			c11 = Cgs_table[((kk+1)*vgs_width_int_Cgs*vds_width_int_Cgs) + ((jj+1)*vgs_width_int_Cgs) + ii];

			c_low = c00*(1 - alpha_y)*(1 - alpha_z)
				  + c01*(1 - alpha_y)*alpha_z
				  + c10*alpha_y*(1 - alpha_z)
				  + c11*alpha_y*alpha_z;

			// fetch at ii+1
			c00 = Cgs_table[(kk*vgs_width_int_Cgs*vds_width_int_Cgs) + (jj*vgs_width_int_Cgs) + (ii+1)];
			c01 = Cgs_table[((kk+1)*vgs_width_int_Cgs*vds_width_int_Cgs) + (jj*vgs_width_int_Cgs) + (ii+1)];
			c10 = Cgs_table[(kk*vgs_width_int_Cgs*vds_width_int_Cgs) + ((jj+1)*vgs_width_int_Cgs) + (ii+1)];
			c11 = Cgs_table[((kk+1)*vgs_width_int_Cgs*vds_width_int_Cgs) + ((jj+1)*vgs_width_int_Cgs) + (ii+1)];

			c_high = c00*(1 - alpha_y)*(1 - alpha_z)
				   + c01*(1 - alpha_y)*alpha_z
				   + c10*alpha_y*(1 - alpha_z)
				   + c11*alpha_y*alpha_z;

			Cgs = c_low*(1 - dx) + c_high*dx;
			interpolate_smoothed2_Cgs = Cgs;
		end
	endfunction


	analog function real interpolate_smoothed2_Cgd;
		input x, y, z;
		input [0:vgd_width_int_Cgd-1] x_points;
		input [0:vds_width_int_Cgd-1] y_points;
		input [0:vgs_width_int_Cgd-1] z_points;
		input [0:vgd_width_int_Cgd*vds_width_int_Cgd*vgs_width_int_Cgd-1] Cgd_table;

		real x, y, z;
		real x_points[0:vgd_width_int_Cgd-1];
		real y_points[0:vds_width_int_Cgd-1];
		real z_points[0:vgs_width_int_Cgd-1];
		real Cgd_table[0:vgd_width_int_Cgd*vds_width_int_Cgd*vgs_width_int_Cgd-1];

		integer i, j, k;
		integer ii, jj, kk;
		real x1, x2, dx, denx;
		real y1, y2, alpha_y, deny;
		real z1, z2, alpha_z, denz;
		real c00, c01, c10, c11, c_low, c_high, Cgd;

		begin
			// x (Vgd)
			if (x <= x_points[0]) ii = 0;
			else if (x >= x_points[vgd_width_int_Cgd-1]) ii = vgd_width_int_Cgd-2;
			else for (i = 0; i < vgd_width_int_Cgd-1; i = i + 1)
				if (x_points[i] <= x && x < x_points[i+1]) ii = i;
			x1 = x_points[ii]; x2 = x_points[ii+1];
			denx = x2 - x1; if (denx < EPS_DEN) denx = EPS_DEN;
			dx = (x - x1) / denx;

			// y (Vds)
			for (j = 0; j < vds_width_int_Cgd-1; j = j + 1)
				if (y_points[j] <= y && y <= y_points[j+1]) begin
					jj = j; y1 = y_points[j]; y2 = y_points[j+1];
				end
			if (y <= y_points[0]) begin jj = 0; y1 = y_points[0]; y2 = y_points[1]; end
			else if (y >= y_points[vds_width_int_Cgd-1]) begin jj = vds_width_int_Cgd-2; y1 = y_points[vds_width_int_Cgd-2]; y2 = y_points[vds_width_int_Cgd-1]; end
			deny = y2 - y1; if (deny < EPS_DEN) deny = EPS_DEN;
			// alpha_y = clip01( (y - y1) / deny );
			alpha_y = (y - y1) / deny;   // no hard clip (we soft-clipped inputs already)

			// z (Vgs)
			for (k = 0; k < vgs_width_int_Cgd-1; k = k + 1)
				if (z_points[k] <= z && z <= z_points[k+1]) begin
					kk = k; z1 = z_points[k]; z2 = z_points[k+1];
				end
			if (z <= z_points[0]) begin kk = 0; z1 = z_points[0]; z2 = z_points[1]; end
			else if (z >= z_points[vgs_width_int_Cgd-1]) begin kk = vgs_width_int_Cgd-2; z1 = z_points[vgs_width_int_Cgd-2]; z2 = z_points[vgs_width_int_Cgd-1]; end
			denz = z2 - z1; if (denz < EPS_DEN) denz = EPS_DEN;
			// alpha_z = clip01( (z - z1) / denz );
			alpha_z = (z - z1) / denz; // no hard clip (we soft-clipped inputs already)

			// fetch at ii
			c00 = Cgd_table[(kk*vgd_width_int_Cgd*vds_width_int_Cgd) + (jj*vgd_width_int_Cgd) + ii];
			c01 = Cgd_table[((kk+1)*vgd_width_int_Cgd*vds_width_int_Cgd) + (jj*vgd_width_int_Cgd) + ii];
			c10 = Cgd_table[(kk*vgd_width_int_Cgd*vds_width_int_Cgd) + ((jj+1)*vgd_width_int_Cgd) + ii];
			c11 = Cgd_table[((kk+1)*vgd_width_int_Cgd*vds_width_int_Cgd) + ((jj+1)*vgd_width_int_Cgd) + ii];

			c_low = c00*(1 - alpha_y)*(1 - alpha_z)
				  + c01*(1 - alpha_y)*alpha_z
				  + c10*alpha_y*(1 - alpha_z)
				  + c11*alpha_y*alpha_z;

			// fetch at ii+1
			c00 = Cgd_table[(kk*vgd_width_int_Cgd*vds_width_int_Cgd) + (jj*vgd_width_int_Cgd) + (ii+1)];
			c01 = Cgd_table[((kk+1)*vgd_width_int_Cgd*vds_width_int_Cgd) + (jj*vgd_width_int_Cgd) + (ii+1)];
			c10 = Cgd_table[(kk*vgd_width_int_Cgd*vds_width_int_Cgd) + ((jj+1)*vgd_width_int_Cgd) + (ii+1)];
			c11 = Cgd_table[((kk+1)*vgd_width_int_Cgd*vds_width_int_Cgd) + ((jj+1)*vgd_width_int_Cgd) + (ii+1)];

			c_high = c00*(1 - alpha_y)*(1 - alpha_z)
				   + c01*(1 - alpha_y)*alpha_z
				   + c10*alpha_y*(1 - alpha_z)
				   + c11*alpha_y*alpha_z;

			Cgd = c_low*(1 - dx) + c_high*dx;
			interpolate_smoothed2_Cgd = Cgd;
		end
	endfunction
	
	real Cgs_eff, Cgd_eff, qgs, qgd;
	real vds_raw, vgs_raw, vgd_raw;
	real vds, vgs, vgd;

	// cache LUT bounds (assumes monotonically sorted arrays)
	real VDS_MIN, VDS_MAX, VGS_MIN, VGS_MAX, VGD_MIN, VGD_MAX;

	analog begin
		//// hint the integrator for sharp logic edges in the neuron
		// bound_step(MAXSTEP);

		// gmin rails to bulk to avoid floating cutsets
		I(d,  b) <+ gmin * V(d,  b);
		I(s,  b) <+ gmin * V(s,  b);
		I(gs, b) <+ gmin * V(gs, b);
		I(gd, b) <+ gmin * V(gd, b);
		// optional: prevent any bulk island from floating numerically
		I(b) <+ gmin * V(b);   // tiny (1/GΩ) anchor to global 0


		// raw terminal voltages
		vds_raw = V(d, s);   // Drain-Source voltage
		vgs_raw = V(gs, s);  // Gate-Source voltage
		vgd_raw = V(gd, s);  // Gate-Source voltage (not drain!)

		// LUT bounds (first/last entries)
		VDS_MIN = vds_points[0];
		VDS_MAX = vds_points[vds_width_int-1];
		VGS_MIN = vgs_points[0];
		VGS_MAX = vgs_points[vgs_width_int-1];
		VGD_MIN = vgd_points[0];
		VGD_MAX = vgd_points[vgd_width_int-1];

		// soft clamp voltages to LUT domain (smooth, no corners)
		vds = soft_clip(vds_raw, VDS_MIN, VDS_MAX, VCLIP_K);
		vgs = soft_clip(vgs_raw, VGS_MIN, VGS_MAX, VCLIP_K);
		vgd = soft_clip(vgd_raw, VGD_MIN, VGD_MAX, VCLIP_K);   // Corrected Vgd to be source-based

		// --- Interpolate Ids, Cgs, Cgd using your functions (no hard clip inside)
		ids_value = interpolate_smoothed2_ids(vds, vgs, vgd, vds_points, vgs_points, vgd_points, table_ids);

		Cgs_value = interpolate_smoothed2_Cgs(
						/* x=Vgs */ vgs,
						/* y=Vds */ vds,
						/* z=Vgd */ vgd_raw /* keep using Vgd_raw as it should be source-relative */,
						vgs_points_Cgs, vds_points_Cgs, vgd_points_Cgs, table_Cgs);

		Cgd_value = interpolate_smoothed2_Cgd(
						/* x=Vgd */ vgd,
						/* y=Vds */ vds,
						/* z=Vgs */ vgs_raw /* likewise: match your Cgd table’s axes */,
						vgd_points_Cgd, vds_points_Cgd, vgs_points_Cgd, table_Cgd);

		// Enforce strictly positive small caps (smooth)
		Cgs_eff = smooth_max(Cgs_value, Cmin, 1e-36);
		Cgd_eff = smooth_max(Cgd_value, Cmin, 1e-36);

		// ---- Charge-based stamping (dQ/dt) ----
		// Cgs between (gs - s)
		qgs = Cgs_eff * V(gs, s);
		I(gs, s) <+ ddt(qgs);

		// Cgd between (gd - s)  *** FIXED: gate-source not gate-drain ***
		qgd = Cgd_eff * V(gd, s);  // Correct Cgd to use source, not drain
		I(gd, s) <+ ddt(qgd);

		// ---- Ids path + tiny linear gds floor (stabilizer) ----
		I(d, s) <+ ids_value;
		I(d, s) <+ gds_floor * V(d, s); // helps when dIds/dV ≈ 0
	end
endmodule

